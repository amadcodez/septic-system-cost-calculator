{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "www.septicsystemcostcalculator.com"}],
      "destination": "https://septicsystemcostcalculator.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "header", "key": "x-forwarded-proto", "value": "http"}],
      "destination": "https://septicsystemcostcalculator.com/:path*",
      "permanent": true
    }
  ]
}
